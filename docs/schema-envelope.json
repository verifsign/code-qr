{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Enveloppe CRM — attestation de signature",
  "description": "Format d'export depuis le CRM de contrôle vers le système QR",
  "type": "object",
  "required": ["id", "organisme", "signataires"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Identifiant unique de l'enveloppe (ex. A7B7434617A74)"
    },
    "organisme": {
      "type": "string",
      "description": "Nom de l'organisme émetteur"
    },
    "intituleDocument": {
      "type": "string",
      "description": "Titre du document signé"
    },
    "statut": {
      "type": "string",
      "description": "État de l'enveloppe (ex. Terminé, En cours)"
    },
    "beneficiaire": {
      "type": "string",
      "description": "Nom du stagiaire / bénéficiaire"
    },
    "creeLe": {
      "type": "string",
      "description": "Date de création telle qu'enregistrée dans le CRM"
    },
    "hashPdf": {
      "type": "string",
      "description": "SHA-256 réel du PDF final (calculé sur le fichier, pas dérivé du nom)"
    },
    "signataires": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["nom", "signeLe"],
        "properties": {
          "nom": { "type": "string" },
          "role": { "type": "string" },
          "email": { "type": "string" },
          "ip": { "type": "string" },
          "signeLe": {
            "type": "string",
            "description": "Horodatage RÉEL enregistré au moment de la signature"
          }
        }
      }
    }
  }
}
