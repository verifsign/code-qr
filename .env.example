# Port d'écoute du serveur
PORT=3000

# URL publique où ce service sera accessible une fois déployé.
# C'est CETTE adresse qui doit être configurée sur ton nom de domaine
# et embarquée dans les QR codes (ex: https://verif.dataforma.fr)
BASE_URL=http://localhost:3000

# Clé secrète que ton CRM doit envoyer dans l'en-tête `x-api-key`
# pour créer/modifier/supprimer des documents.
# Génère une valeur longue et aléatoire, ex: openssl rand -hex 32
API_KEY=change-moi-avec-une-vraie-cle-secrete

# Nom de ton organisme, affiché par défaut si un document n'en précise pas.
DEFAULT_ORG=DATA FORMA
